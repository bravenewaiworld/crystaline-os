# Buildroot configuration shared by every family; the Makefile appends the family's
# (system/family/<family>/buildroot.config: CPU, kernel headers, overlays, graphics). Buildroot builds
# only the base (C library, BusyBox, daemons); our kernel, Specular, cores and other parts are built
# by the top-level Makefile and added when the image is assembled (tools/system/build-system.sh), so
# changing them never rebuilds anything here.

# Toolchain: glibc, with C++ for later packages (Specular's cores are built with it too).
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# System: BusyBox init (services are supervised by BusyBox's runit applets, see
# common/rootfs-overlay/etc/sv), devices by the kernel's devtmpfs plus mdev.
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y
BR2_SYSTEM_DHCP=""
# Development: root logs in without a password on the serial console (the family's getty port); SSH
# takes keys only. Release images set one that no password matches, so no serial login
# (tools/system/build-system.sh).
BR2_TARGET_ENABLE_ROOT_LOGIN=y
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_CRYSTALINE_PATH)/common/post-build.sh"
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_CRYSTALINE_PATH)/common/busybox.fragment"
# Time zones for crystaline-timezone. BR2_TARGET_LOCALTIME is empty so that Buildroot makes no
# /etc/localtime: post-build.sh links it into the state area (and drops the zones' leap-second
# variants, right/).
BR2_TARGET_TZ_INFO=y
BR2_TARGET_LOCALTIME=""

# Sound: amixer sets the volume (Specular); bluez-alsa plays to Bluetooth headphones.
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ_ALSA=y
BR2_PACKAGE_DBUS=y

# Networking: WiFi, SSH (OpenSSH: reads the development host keys as they are, and has the SFTP
# server modern scp uses; ssh-keygen makes a release image's host keys on the device).
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_OPENSSH=y
# BR2_PACKAGE_OPENSSH_CLIENT is not set
BR2_PACKAGE_OPENSSH_SERVER=y
BR2_PACKAGE_OPENSSH_KEY_UTILS=y

# Storage: checking and making filesystems, partitioning (the data card, the installer).
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_FSCK=y
# The installer reads back the system partition it made, without mounting it.
BR2_PACKAGE_E2FSPROGS_DEBUGFS=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y
BR2_PACKAGE_DOSFSTOOLS_FATLABEL=y
# exFAT tools from system/package/exfatprogs-upstream: a newer exfatprogs than Buildroot's, for
# fsck.exfat's repair fixes.
BR2_PACKAGE_EXFATPROGS_UPSTREAM=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
BR2_PACKAGE_ZSTD=y

# Debugging (DEVELOPMENT.md): strace, perf (system/package/linux-perf), and gdbserver with a cross
# gdb for the PC (host/bin/aarch64-buildroot-linux-gnu-gdb). strace's call stacks (strace -k) use
# elfutils' libdw, which nothing asks for: strace finds it only because perf brings elfutils and
# Buildroot builds packages one at a time in name order. Without perf, -k is gone. Release images
# leave all of this out (common/debug-tools.list).
BR2_PACKAGE_STRACE=y
BR2_PACKAGE_LINUX_PERF=y
BR2_PACKAGE_GDB=y
BR2_PACKAGE_GDB_SERVER=y
# BR2_PACKAGE_GDB_DEBUGGER is not set
BR2_PACKAGE_HOST_GDB=y

# Output: a tar of the root filesystem, which build-system.sh extends and packs into squashfs
# (with the host's sqfstar, so no root rights are needed for file owners).
BR2_TARGET_ROOTFS_TAR=y
# BR2_TARGET_ROOTFS_EXT2 is not set
BR2_PACKAGE_HOST_SQUASHFS=y
# depmod: build-system.sh runs it after adding our kernel modules (the PC may not have one).
BR2_PACKAGE_HOST_KMOD=y

# Our patches to Buildroot's packages, in system/patches/<package>/.
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_CRYSTALINE_PATH)/patches"
