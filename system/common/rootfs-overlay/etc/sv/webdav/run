#!/bin/sh
# File transfer: dufs (github.com/sigoden/dufs) serves the data card on port 80, both as WebDAV
# (mountable in PC file managers) and as a browser page for uploading and downloading. Down at
# start-up (the `down` file): Specular runs it only while its "File transfer" screen is open
# (sv up webdav, sv down webdav). No password: while it runs, anyone on the network can read and
# write the card.
# It runs as www-data, not root: the card's mount options let that group write it (mount-card),
# and /usr/bin/dufs carries the right to listen on port 80 (a file capability, cap_net_bind_service,
# set by tools/system/tar-with-owners.py). -A: allow uploads, deletes and search. --assets: our
# own browser page (system/common/webui) instead of dufs's, served from a copy in /run that names
# this device (BOARD_NAME).
exec 2>&1
# No data card: stay down rather than retry every second.
mountpoint -q /mnt/SDCARD || { sv down webdav; exit 0; }
WEB=/run/crystaline/web
mkdir -p $WEB
cp /usr/share/crystaline-web/app.js /usr/share/crystaline-web/app.css $WEB/
name=$(. /run/crystaline/board.env && printf '%s' "$BOARD_NAME" | sed 's/[&/\\]/\\&/g')
sed "s/@BOARD_NAME@/${name:-Crystaline OS}/g" /usr/share/crystaline-web/index.html >$WEB/index.html
exec chpst -u www-data /usr/bin/dufs -A --assets $WEB -p 80 /mnt/SDCARD
