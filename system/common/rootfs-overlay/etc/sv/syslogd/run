#!/bin/sh
# The system log, both in memory for logread (-C: 512 KiB) and in /system/logs/messages on the
# system partition, which survives reboots. The file is rotated at 512 KiB, keeping one older file
# (messages.0), so it takes at most 1 MiB of the system partition. -C and -O together need our
# BusyBox patch (system/patches/busybox).
exec syslogd -n -C512 -O /system/logs/messages -s 512 -b 1
