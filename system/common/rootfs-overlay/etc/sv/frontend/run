#!/bin/sh
# Specular, the frontend (frontend-run falls back to the `status` screen, tools/device/status.c,
# if it keeps crashing). A family whose buttons come from a program waits for it in its own copy
# of this file (the Brick's: system/family/brick/rootfs-overlay/etc/sv/frontend/run).
exec 2>&1
exec /usr/bin/frontend-run
