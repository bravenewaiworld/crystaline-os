# The RK3566's part of the mainline family's Buildroot configuration (the Makefile appends it to
# the family's). ARM's own driver for its Mali-G52 (Bifrost), as an alternative to Mesa's, chosen on
# the device (family-hooks): ROCKNIX's choice of Rockchip's builds.
BR2_PACKAGE_LIBMALI=y
BR2_PACKAGE_LIBMALI_LIB="libmali-bifrost-g52-g29p1.so"
