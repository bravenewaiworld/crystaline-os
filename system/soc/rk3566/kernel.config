# Kernel configuration for the blocks inside the Rockchip RK3566 (merged by tools/mainline/kmake.sh
# after system/family/mainline/kernel.config): clocks, pins, display (VOP2, DSI, HDMI), GPU
# (Panfrost), SD/MMC, USB, PHYs, audio interfaces, thermal, IOMMU.
CONFIG_ARCH_ROCKCHIP=y
CONFIG_ROCKCHIP_PHY=y
CONFIG_I2C_RK3X=y
CONFIG_SPI_ROCKCHIP=y
CONFIG_SPI_ROCKCHIP_SFC=y
CONFIG_ROCKCHIP_THERMAL=y
CONFIG_DW_WATCHDOG=y
CONFIG_VIDEO_ROCKCHIP_RGA=m
CONFIG_VIDEO_ROCKCHIP_VDEC=y
CONFIG_DRM_MALI_DISPLAY=y
CONFIG_DRM_DW_HDMI_CEC=y
CONFIG_DRM_PANFROST=m
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP2=y
CONFIG_ROCKCHIP_DW_HDMI=y
CONFIG_ROCKCHIP_DW_MIPI_DSI=y
CONFIG_SND_SOC_ROCKCHIP_I2S_TDM=y
CONFIG_SND_SOC_ROCKCHIP_PDM=y
CONFIG_SND_SOC_ROCKCHIP_SPDIF=y
CONFIG_SND_SOC_RK3288_HDMI_ANALOG=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC2=y
CONFIG_MMC_SDHCI_OF_DWCMSHC=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_ROCKCHIP_MBOX=y
CONFIG_ROCKCHIP_IOMMU=y
CONFIG_ROCKCHIP_IODOMAIN=y
CONFIG_DEVFREQ_EVENT_ROCKCHIP_DFI=y
CONFIG_ROCKCHIP_SARADC=y
CONFIG_PWM_ROCKCHIP=y
CONFIG_PHY_ROCKCHIP_DP=y
CONFIG_PHY_ROCKCHIP_DPHY_RX0=y
CONFIG_PHY_ROCKCHIP_EMMC=y
CONFIG_PHY_ROCKCHIP_INNO_HDMI=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_PHY_ROCKCHIP_INNO_CSIDPHY=y
CONFIG_PHY_ROCKCHIP_INNO_DSIDPHY=y
CONFIG_PHY_ROCKCHIP_NANENG_COMBO_PHY=y
CONFIG_PHY_ROCKCHIP_PCIE=y
CONFIG_PHY_ROCKCHIP_SNPS_PCIE3=y
CONFIG_PHY_ROCKCHIP_USB=y
CONFIG_NVMEM_ROCKCHIP_OTP=y
CONFIG_CRYPTO_DEV_ROCKCHIP=y
