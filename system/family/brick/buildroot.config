# Buildroot configuration of the Brick family, after system/common/buildroot.config.

# Allwinner A133P: 4x Cortex-A53.
BR2_aarch64=y
BR2_cortex_a53=y

# glibc: TrimUI's GPU libraries need it (they ask for glibc 2.17 or newer). Kernel headers must not
# be newer than the kernel: ours is 4.9.191.
BR2_KERNEL_HEADERS_VERSION=y
BR2_DEFAULT_KERNEL_VERSION="4.9.191"
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_4_9=y

BR2_TARGET_GENERIC_HOSTNAME="brick"
BR2_TARGET_GENERIC_ISSUE="Brick"
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y

# Vulkan, for the GameCube games (Tesseract): Khronos' loader, with TrimUI's driver as its one
# ICD (tools/system/build-system.sh copies the driver; the overlay registers it in
# /usr/share/vulkan/icd.d). No X11 or Wayland, so the loader has only VK_KHR_display.
BR2_PACKAGE_VULKAN_LOADER=y

