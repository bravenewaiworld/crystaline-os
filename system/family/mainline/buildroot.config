# Buildroot configuration of the mainline family (boards on mainline Linux: the RGB20 Pro, later the
# Orange Pi 5), after system/common/buildroot.config. One root filesystem serves every board of the
# family; each board's names come from its overlay, picked at start-up (board-env). The Makefile
# adds the overlays (BR2_ROOTFS_OVERLAY).

# Cortex-A55 (RK3566); the A76 and A55 cores of later boards run this code too.
BR2_aarch64=y
BR2_cortex_a55=y

# Kernel headers must not be newer than the kernel (ours is 7.3); 6.19 is the newest Buildroot has.
BR2_KERNEL_HEADERS_6_19=y

BR2_TARGET_GENERIC_HOSTNAME="crystaline"
BR2_TARGET_GENERIC_ISSUE="Crystaline OS"
# The RK3566's debug UART runs at 1,500,000 baud, which getty can't be told: it keeps what the
# kernel's console set.
BR2_TARGET_GENERIC_GETTY_PORT="ttyS2"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_KEEP=y

# Firmware from linux-firmware: the RTL8821CS's WiFi (rtw88) and Bluetooth.
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW88=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_88XX_BT=y

# Display: libdrm, with its test programs (modetest: modes, planes, a test pattern) for development.
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_LIBDRM_INSTALL_TESTS=y
