# What start-up does differently in the mainline family ("hooks"). The shared start-up scripts (the
# initramfs's init, rcS) source this file and call these functions where families differ; every
# family defines all of them.

# progress CODE: record how far start-up got (the codes are listed in the initramfs's init) as a
# kernel log line. The kernel keeps its log in RAM across a warm reset (ramoops), so after a start
# that failed without a message, the next start's /system/logs/crash-*/ or /sys/fs/pstore has it:
# grep 'crystaline-progress'.
progress() { printf 'crystaline-progress %04x\n' $(($1)) >/dev/kmsg 2>/dev/null; }

# start_hardware: rcS, before the data card is mounted. Nothing yet: mdev loads the drivers the
# device tree asks for (the GPU's among them).
start_hardware() { :; }

# rescue: the initramfs's start-up has failed for good; its message is already on screen. The last
# chance to make the failure visible another way: the board's status LED blinks, so a failure shows
# even when the screen doesn't.
rescue() {
	for led in /sys/class/leds/*:status; do
		[ -e "$led/trigger" ] && echo timer >"$led/trigger"
	done
}
