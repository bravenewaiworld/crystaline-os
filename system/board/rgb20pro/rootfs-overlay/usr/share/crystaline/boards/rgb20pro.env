# The Powkiddy RGB20 Pro: hardware names (device-tree, driver and sysfs names) that differ between
# boards, read by start-up and the system's
# scripts (/usr/libexec/crystaline/board-env picks this file). Plain shell assignments;
# BOARD_COMPATIBLE unquoted, since board-env looks for its line as written.
# BOARD_CARD_CONTROLLER: the SD card slot the device starts from, as /sys/bus/platform/devices names
# its controller. BOARD_CARD_LABEL: the FAT label mount-card gives the games partition it makes (at
# most 11 characters). BOARD_BATTERY: the battery's /sys/class/power_supply name.
# BOARD_WIFI_MODULE: the WiFi driver's module (the wpa_supplicant service loads it).
# BOARD_USB_NET: the USB network link's /24 (the device is .2), different for each board.
BOARD_COMPATIBLE=powkiddy,rgb20-pro
BOARD_NAME='RGB20 Pro'
# sdmmc0, the slot the RK3566 starts from. The second slot (fe2c0000.mmc) will hold games only; the
# system doesn't use it yet.
BOARD_CARD_CONTROLLER=fe2b0000.mmc
BOARD_CARD_LABEL=RGB20PRO
BOARD_BATTERY=rk817-battery
# The RTL8723DS on SDIO (SDIO 024c:d723; ROCKNIX's device tree names the RTL8821CS, its sibling boards' chip).
BOARD_WIFI_MODULE=rtw88_8723ds
BOARD_USB_NET=192.168.8
# BOARD_CPU_EFFICIENT_MHZ: the fastest CPU speed at about the lowest voltage (crystaline-power's
# profiles): 1416 MHz at 0.9 V, as 1104 is.
BOARD_CPU_EFFICIENT_MHZ=1416
