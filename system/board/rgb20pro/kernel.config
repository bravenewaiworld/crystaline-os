# Kernel configuration for the chips on the Powkiddy RGB20 Pro's board (merged by
# tools/mainline/kmake.sh after the family's and the SoC's parts): the RK817 power chip (regulators,
# charger, clock, real-time clock, power key, audio codec), the panel, the sticks (an ADC behind a
# GPIO analog switch) and rumble, and the RTL8821CS's WiFi and Bluetooth.
CONFIG_BT_HCIUART_RTL=y
CONFIG_RTW88_8821CS=m
CONFIG_JOYSTICK_ADC=y
CONFIG_INPUT_PWM_VIBRA=y
CONFIG_INPUT_RK805_PWRKEY=y
CONFIG_PINCTRL_RK805=y
CONFIG_CHARGER_RK817=y
CONFIG_MFD_RK8XX_I2C=y
CONFIG_REGULATOR_RK808=y
CONFIG_DRM_PANEL_GENERIC_DSI=y
CONFIG_SND_SOC_RK817=y
CONFIG_RTC_DRV_RK808=y
CONFIG_COMMON_CLK_RK808=y
CONFIG_IIO_MUX=y
CONFIG_MUX_GPIO=y
