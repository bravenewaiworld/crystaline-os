#!/bin/sh
# First program the kernel runs (the boot image's initramfs). Mounts the system partition, then
# this version's read-only system image from it, and hands over to that system's init.
#
# Which version runs is decided by the boot image alone, which U-Boot loads from the boot slot its
# settings name (boot_a or boot_b, passed on as brick.boot=): each boot image carries its own
# version (/etc/brick-version) and mounts images/<that version>/ from the system partition, so the
# kernel and its modules always match. The system partition is found by its filesystem UUID,
# which U-Boot's settings put on the command line as root=UUID=... (the same names exist on both
# the SD card and the internal storage, so names can't tell them apart).
#
# System partition (ext4):
#   images/<version>/rootfs.squashfs   the root filesystem, mounted read-only
#   overlay/<version>/                 developer mode: a writable layer over that version's root
#   state/  logs/                      kept across versions (see /usr/libexec/brick/state and
#                                      /etc/init.d/rcS in the system)
#
# Progress codes: each stage of the start-up (here, then the system's rcS) writes 0xB007XXYY to
# the clock chip's spare register 7 (0x0700011C), which survives resets and power-off. YY is the
# stage: 01 started, 02 watchdog, 03 system partition found, 04 checked, 05 mounted, 06 image
# mounted, 07 handing over, 08 recovery menu shown, 09 recovery action running; rcS: 10 started,
# 11 data card, 12 services starting. XX is 00, or 03 while the partition is checked with YY then
# counting the seconds it has taken (to 255), or EE once stage YY has failed. 08 and 09 aren't
# stages: when the menu returns, the register goes back to the stage reached. After a start that
# failed without a message (e.g. a reset loop), boot another card and read it (memreg
# 0x0700011C): no B007 prefix means this program never ran.
#
# Start-up log: from the moment the system partition is found until the hand-over, this program's
# log, the kernel's log and the running programs are copied every second to brick-log/ on the
# "bootloader" partition (FAT, readable on a PC) of the disk the system is on, so a start that
# ends in a reset still leaves them behind.
#
# Recovery menu: holding MENU while the device starts, or a start that fails once the system
# partition is mounted, shows a menu (drawn by status) that can continue starting (if nothing
# failed), start the previous version, install an update file from the SD card, or power off
# (docs/boot.md).
progress() { devmem 0x0700011C 32 $((0xB0070000 | $1)) 2>/dev/null; }
stage() { STAGE=$1; progress $1; }

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
stage 0x01
VERSION=$(cat /etc/brick-version)

# The kernel arms a 16 s hardware watchdog at boot and never resets it itself. This daemon resets
# it from here on, for good: it keeps running after the hand-over (its program stays in memory),
# so there is no gap for a slow start-up to fall into.
watchdog -T 16 -t 4 /dev/watchdog
stage 0x02

LOG=/run-init.log
# log MESSAGE: to the kernel log and $LOG, and, once a recovery menu has been shown, to its own log
# on the system partition ($RLOG) as well.
log() { echo "brick-init: $*" >/dev/kmsg; echo "$*" >>$LOG; [ -z "$RLOG" ] || echo "$*" >>$RLOG; }
# Checked once, here, so MENU must be down now; the menu itself waits for the system partition.
if status --held MENU 2>>$LOG; then
	WANT_MENU=1
	log "MENU held: recovery menu once the system partition is mounted"
	status --message "Opening the recovery menu..." >/dev/kmsg 2>&1
fi

# card_disk: the disk (e.g. mmcblk1) on the SD card's controller (sdc0), if a card is in.
card_disk() {
	set -- /sys/bus/platform/devices/sdc0/mmc_host/mmc*/mmc*:*/block/mmcblk*
	[ -e "$1" ] && echo ${1##*/}
}

# on_card: whether the system being started is on the SD card: whether $disk, the disk holding the
# system partition, is the card's. Before that is found, a guess: whether the card in the slot has
# a bootloader partition (it is one of ours, and the device starts from the card when it can).
on_card() {
	c=$(card_disk) || return 1
	if [ -n "$disk" ]; then [ "$disk" = "$c" ]; else grep -qs '^PARTNAME=bootloader$' /sys/block/$c/${c}p*/uevent; fi
}

# fail TITLE [DETAIL]: report why the system can't start, then wait for good (the watchdog daemon
# keeps the device from resetting). Once the system partition is mounted, the report is the
# recovery menu; before that, or if the menu can't be shown, it is a message saying what to do,
# with DETAIL (for a developer) under it.
fail() {
	log "failed: $*"
	! grep -q ' /system ' /proc/mounts || recovery "$*"
	progress $((0xEE00 | STAGE))
	if on_card; then
		fix="Copy your games, saves and backups/ off this card on a PC, then write Crystaline OS to it again."
	else
		fix="Insert an SD card with Crystaline OS written to it and restart."
	fi
	status --message "$1" "" "$fix" "(hold the power button to turn off)" "" \
		${2:+-d "Details: $2"} -d "Version $VERSION" >/dev/kmsg 2>&1
	while :; do sleep 3600; done
}

# --- Recovery menu ----------------------------------------------------------------------------
# Its actions run brick-install on /system and the SD card's data partition, mounted at /card.
# The progress register says 08 while it shows and 09 while an action runs; STAGE stays as it was,
# so a later failure still reports the stage reached.

# bi ARG...: brick-install for the recovery menu; callers log its output. --status: its default is
# in /run, which the initramfs lacks. Without an SD card, /card is an empty folder in memory, so
# brick-install's own log (logs/ there) is lost; its output is still in $RLOG.
bi() { brick-install "$@" --system /system --data /card --status /brick-install.status; }

# finish reboot|poweroff WHY: save the logs, unmount everything, then restart or power off at once.
finish() {
	log "$1: $2"
	stop_saver
	umount /newroot /lower /card /system 2>/dev/null
	sync
	$1 -f
}

# card_options: the SD card's mount options, shared with mount-card. (A missing file would end this
# script, the kernel's first program, if sourced unchecked.)
[ ! -f /usr/libexec/brick/card-options ] || . /usr/libexec/brick/card-options

# mount_card: mount the SD card's data partition at /card, as the system's
# /usr/libexec/brick/mount-card does (but never making or formatting one, which stays its job): on
# the disk on the SD card's controller (sdc0), the partition named "sdcard", else the first FAT32 or
# exFAT one other than "bootloader". Without one, prints why (shown as a note) and fails.
mount_card() {
	grep -q ' /card ' /proc/mounts && return
	c=$(card_disk) || { echo "No SD card"; return 1; }
	# Last, the whole card, for a card formatted without partitions.
	for p in $(grep -l '^PARTNAME=sdcard$' /sys/block/$c/${c}p*/uevent 2>/dev/null |
		sed 's|.*/\(.*\)/uevent|\1|') $(ls /sys/block/$c | sed -n "s/^${c}p//p" | sort -n |
		sed "s/^/${c}p/") $c; do
		grep -q '^PARTNAME=bootloader$' /sys/block/$c/$p/uevent 2>/dev/null && continue
		for t in vfat exfat; do
			mount -t $t -o $(card_options $t $(cat /etc/brick/www-data-gid)) /dev/$p /card \
				2>/dev/null && { log "data partition $p ($t) mounted at /card"; return; }
		done
	done
	echo "The SD card has no FAT32 or exFAT partition"
	return 1
}

# menu TITLE [-n NOTE | -b B-TEXT]... ITEM...: show a menu (status --menu) and set $chosen to the
# item chosen. Returns 1 for B, 3 if it can't be shown; powers off after 10 minutes without a press.
menu() {
	i=$(status --menu "$@" 2>>$LOG)
	case $? in
	0) ;;
	1) return 1 ;;
	2) finish poweroff "no button pressed for 10 minutes" ;;
	*) log "can't show the recovery menu"; return 3 ;;
	esac
	shift
	while [ "$1" = -n ] || [ "$1" = -b ]; do shift 2; done
	[ "$i" -ge 0 ] 2>/dev/null && [ "$i" -lt $# ] || { log "status --menu printed '$i'"; return 3; }
	shift $i
	chosen=$1
	log "chosen: $chosen"
}

# task TITLE ARG...: run brick-install ARG..., showing its progress (status --task), then restart
# once the user has read that it worked. Returns if it failed.
task() {
	t=$1
	shift
	progress 0x09
	log "brick-install $*"
	bi "$@" 2>&1 | tee -a $LOG $RLOG | status --task "$t" 2>>$LOG
	case $? in
	0) finish reboot "brick-install $1 done" ;;
	2) finish poweroff "no button pressed for 10 minutes" ;;
	esac
	progress 0x08
}

# updates: the names of the card's update files, newest first (their names start with the
# version's build time).
updates() { ls -r /card/updates 2>/dev/null | grep '\.update$'; }

# install_update: choose one of the card's 10 newest update files (10 fit on screen), install it.
install_update() {
	set --
	while read -r f; do [ -z "$f" ] || set -- "$@" "$f"; done <<-EOF
	$(updates | head -n 10)
	EOF
	menu "Install an update from the SD card" "$@" &&
		task "Installing $chosen" update "/card/updates/$chosen"
}

# recovery REASON: the recovery menu. REASON is why the start failed, or empty. Returns when the
# user chooses to continue starting (offered only when nothing failed), or if it can't be shown.
recovery() {
	reason=$1
	mkdir -p /system/logs
	RLOG=/system/logs/recovery-$(date -u +%Y%m%d-%H%M%S).log
	cp $LOG $RLOG
	set -- /system/logs/recovery-*.log	# keep the newest 10 (the names sort by time)
	while [ $# -gt 10 ]; do rm -f "$1"; shift; done
	log "recovery menu${reason:+ after: $reason}"
	while :; do
		progress 0x08
		note=$(mount_card)
		# "boot_a|boot_b <version|unknown> [running|previous]" per slot, then "next <slot>".
		slots=$(bi slots 2>&1)
		log "brick-install slots: $slots"
		prev=$(echo "$slots" | sed -n 's/^boot_[ab] \([^ ]*\) previous$/\1/p')
		set --
		[ -n "$reason" ] || set -- "Continue starting"
		[ -z "$prev" ] || [ "$prev" = "$VERSION" ] || set -- "$@" "Start the previous version $prev"
		if [ -n "$(updates)" ]; then
			set -- "$@" "Install an update from the SD card"
		elif [ -z "$note" ]; then
			note="No update files in updates/ on the SD card"
		fi
		set -- "$@" "Power off"
		menu "Crystaline OS recovery" -b "check the SD card again" -n "Version $VERSION (${slot:-slot unknown})" \
			${reason:+-n "Couldn't start: $reason"} ${note:+-n "$note"} "$@"
		case $? in
		0) ;;
		1) continue ;;	# B: shown again, after looking at the card again (e.g. one just inserted)
		*) break ;;
		esac
		case $chosen in
		Continue*) break ;;
		Start*) task "Starting the previous version" activate "$prev" ;;
		Install*) install_update ;;
		Power*) finish poweroff "chosen in the recovery menu" ;;
		esac
	done
	umount /card 2>/dev/null	# the system mounts the card itself
	progress $STAGE
}

# The boot slot this image was loaded from (see the top).
slot=$(sed -n 's/.* brick\.boot=\([^ ]*\).*/\1/p' /proc/cmdline)
log "version $VERSION, slot ${slot:-unknown}"
uuid=$(sed -n 's/.* root=UUID=\([^ ]*\).*/\1/p' /proc/cmdline)
[ -n "$uuid" ] || fail "No system partition given" "U-Boot's settings lack root=UUID=..."
# The storage may still be starting up.
for _ in 1 2 3 4 5; do dev=$(findfs UUID=$uuid 2>/dev/null) && break; sleep 1; done
[ -n "$dev" ] || fail "System partition not found" "No partition has the filesystem UUID $uuid"
stage 0x03

# The start-up log on the bootloader partition (see the top).
save_log() {
	cp $LOG /bootlog/brick-log/init.log; dmesg >/bootlog/brick-log/dmesg.txt
	ps >/bootlog/brick-log/ps.txt; sync
}
# stop_saver: stop the copying, copy a last time and unmount the bootloader partition.
stop_saver() { [ -z "$saver" ] || { kill $saver; wait $saver 2>/dev/null; save_log; umount /bootlog; }; }
disk=${dev#/dev/}; disk=${disk%p*}
bl=$(grep -l '^PARTNAME=bootloader$' /sys/block/$disk/${disk}p*/uevent | sed 's|.*/\(.*\)/uevent|/dev/\1|')
if [ -n "$bl" ] && mount -t vfat $bl /bootlog; then
	mkdir -p /bootlog/brick-log
	while :; do save_log; sleep 1; done &
	saver=$!
fi

# After a power cut: replay the journal and fix what -p (preen) fixes safely. Exit status: 0 clean,
# 1 fixed, 2 fixed but the system must restart, 4 or more: not fixed.
e2fsck -p $dev >>$LOG 2>&1 &
checker=$!
n=0
while kill -0 $checker 2>/dev/null; do
	progress $((0x300 + (n < 255 ? n : 255)))
	# A clean check takes well under a second; a long one follows a power loss (the filesystem
	# wasn't unmounted) and goes on silently otherwise.
	[ $n -ne 2 ] || status --message "Checking the system storage after an unexpected power-off" \
		"This can take a minute; don't turn the device off." >/dev/kmsg 2>&1
	n=$((n + 1))
	sleep 1
done
wait $checker
rc=$?
log "e2fsck $dev: $rc"
[ $rc -eq 2 ] && reboot -f
[ $rc -lt 4 ] || fail "System partition damaged" "e2fsck $dev exit status $rc"
stage 0x04
mount -t ext4 -o noatime $dev /system || fail "Can't mount the system partition" "$dev"
stage 0x05
[ -z "$WANT_MENU" ] || recovery ""

img=/system/images/$VERSION/rootfs.squashfs
[ -f $img ] || fail "System image missing" "$img"
mount -t squashfs -o loop,ro $img /lower || fail "Can't mount the system image" "$img"
stage 0x06
up=/system/overlay/$VERSION
if [ -d $up ]; then
	log "developer mode: writable layer $up"
	mkdir -p $up/upper $up/work
	mount -t overlay overlay -o lowerdir=/lower,upperdir=$up/upper,workdir=$up/work /newroot ||
		fail "Can't mount the developer layer" "$up"
else
	mount --bind /lower /newroot
fi
[ -x /newroot/sbin/init ] || fail "System image incomplete" "$img has no /sbin/init"

mkdir -p /system/logs
cp $LOG /system/logs/init.log
stage 0x07	# while /dev/mem is still here
stop_saver
mount --move /system /newroot/system
for d in dev proc sys; do mount --move /$d /newroot/$d; done
exec switch_root /newroot /sbin/init
