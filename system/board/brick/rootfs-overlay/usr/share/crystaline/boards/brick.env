# The TrimUI Brick: hardware names (device-tree, driver and sysfs names) that differ between boards, read by start-up and the system's scripts
# (/usr/libexec/crystaline/board-env picks this file). Plain shell assignments; BOARD_COMPATIBLE
# unquoted, since board-env looks for its line as written.
# BOARD_CARD_CONTROLLER: the SD card slot the device starts from, as /sys/bus/platform/devices names
# its controller. BOARD_CARD_LABEL: the FAT label mount-card gives the games partition it makes (at
# most 11 characters). BOARD_BATTERY: the battery's /sys/class/power_supply name.
# BOARD_WIFI_MODULE: the WiFi driver's module (the wpa_supplicant service loads it).
# BOARD_USB_NET: the USB network link's /24 (the device is .2), different for each board.
# The chip's compatible string: the Brick has no board-specific one.
BOARD_COMPATIBLE=allwinner,a133
BOARD_NAME=Brick
BOARD_CARD_CONTROLLER=sdc0
BOARD_CARD_LABEL=BRICK
BOARD_BATTERY=axp2202-battery
# The XR829: 2.4 GHz only.
BOARD_WIFI_MODULE=xr829_wlan
BOARD_USB_NET=192.168.7
# BOARD_CPU_EFFICIENT_MHZ: the fastest CPU speed at about the lowest voltage (crystaline-power's
# profiles). BOARD_USB_TOP_EHCI, BOARD_USB_TOP_OHCI: the switchable USB port's controllers as
# driver:device, and BOARD_USB_TOP_VBUS its 5 V regulator (crystaline-power usb-top); unset on boards
# without one.
BOARD_CPU_EFFICIENT_MHZ=1200
BOARD_USB_TOP_EHCI=sunxi-ehci:5200000.ehci1-controller
BOARD_USB_TOP_OHCI=sunxi-ohci:5200000.ohci1-controller
BOARD_USB_TOP_VBUS=usb1-vbus
