# The TrimUI Brick: names that differ between boards, read by start-up and the system's scripts
# (/usr/libexec/crystaline/board-env picks this file). Plain shell assignments; BOARD_COMPATIBLE
# unquoted, since board-env looks for its line as written.
BOARD_COMPATIBLE=allwinner,a133
BOARD_NAME=Brick
BOARD_CARD_CONTROLLER=sdc0
BOARD_CARD_LABEL=BRICK
BOARD_BATTERY=axp2202-battery
# The XR829: 2.4 GHz only.
BOARD_WIFI_MODULE=xr829_wlan
