#!/bin/sh /etc/rc.common
# Start padbridge (see padbridge.c) at boot under procd, OpenWrt's service supervisor, which
# restarts it if it exits (giving up after 5 quick exits). START=70: before NextUI (START=99), so
# the virtual gamepad normally exists by the time NextUI looks for controllers.
START=70
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/padbridge
	procd_set_param stderr 1	# its error messages go to the system log (logread)
	procd_set_param respawn
	procd_close_instance
}
