#!/bin/sh
# powertest: unattended overnight power and stability test. Runs a sequence of phases, logging the
# battery, temperatures and CPU state, so that the phases' battery drain can be compared afterwards.
# The battery gauge reports only whole percent (about 30 mAh) and no discharge current, hence the
# long phases.
# Start it detached, then unplug USB within a minute (charging hides the drain):
#   start-stop-daemon -S -b -x /usr/bin/powertest
# Results go to /mnt/SDCARD/powertest/<start time>/:
# - log.csv: time, phase, battery %, battery µV, USB online, CPU kHz, temperatures (°C, in
#   /sys/class/thermal zone order, listed in zones.txt), load average, brick-power profile;
# - <phase>.start/.end.*: interrupt counts, CPU idle-state statistics, per-process wakeups
#   (voluntary context switches) and CPU time, to attribute what keeps the CPUs awake, and the
#   power settings in effect (.power: brick-power's report).
# Phases (minutes); "base" = the settings the system boots with (see base()), "tuned" = the power
# settings under evaluation (see tuned(); chosen from the environment: TUNED_PROFILE, default
# balanced; TUNED_USB_TOP, default off; TUNED_SAMPLING, the CPU governor's sampling interval in µs,
# default brick-power's 50 ms):
#   sleep       deep sleep, woken by the real-time clock's alarm
#   idle-base   screen on (frontend running), base settings
#   idle-tuned  screen on, tuned
#   off-tuned   panel switched off and frontend stopped, tuned
#   load-tuned  all four CPUs busy and the GPU drawing, tuned; also shows whether the regulators'
#               automatic mode (a boot default) holds under full load: if the device crashes, the
#               log stops there
#   load-base   the same load, base settings
# The frontend is stopped from off-tuned to the end of the load phases (if off-tuned runs). Stops
# early below 10 % battery. Ends with the base settings, display and frontend restored, and the
# device asleep.
set -u
# Phase lengths in minutes; each can be overridden from the environment (e.g. all 1 for a dry run).
# A phase of 0 minutes is skipped: e.g. IDLE_MIN=0 OFF_MIN=0 LOAD_MIN=0 SLEEP_MIN=480 measures
# only an 8-hour deep sleep.
SLEEP_MIN=${SLEEP_MIN:-120} IDLE_MIN=${IDLE_MIN:-90} OFF_MIN=${OFF_MIN:-60} LOAD_MIN=${LOAD_MIN:-30}
OUT=/mnt/SDCARD/powertest/$(date +%Y%m%d-%H%M)
BAT=/sys/class/power_supply/axp2202-battery
CPU=/sys/devices/system/cpu/cpufreq/policy0
PHASE=start LOAD_PIDS=

sample() {
	t=
	# A failed read leaves the field empty: the memory sensor's first read after waking fails
	# ("Resource temporarily unavailable").
	for z in /sys/class/thermal/thermal_zone*; do
		v=$(cat $z/temp 2>/dev/null) && t="$t,$((v / 1000))" || t="$t,"
	done
	printf '%s,%s,%s,%s,%s,%s%s,%s,%s\n' "$(date +%s)" "$PHASE" "$(cat $BAT/capacity)" \
		"$(cat $BAT/voltage_now)" "$(cat /sys/class/power_supply/axp2202-usb/online)" \
		"$(cat $CPU/scaling_cur_freq)" "$t" "$(cut -d' ' -f1 /proc/loadavg)" \
		"$(cat /run/brick-power/profile 2>/dev/null)" >>$OUT/log.csv
	sync
}

snapshot() {	# $1: file name prefix
	cat /proc/interrupts >$OUT/$1.interrupts
	for s in /sys/devices/system/cpu/cpu*/cpuidle/state*; do
		echo "$s $(cat $s/usage) $(cat $s/time)"
	done >$OUT/$1.cpuidle
	for p in /proc/[0-9]*; do	# pid, name, wakeups, CPU time (ticks: user, system)
		echo "${p#/proc/} $(cat $p/comm 2>/dev/null)" \
			"$(awk '/^voluntary_ctxt_switches/ {print $2}' $p/status 2>/dev/null)" \
			"$(awk '{print $14, $15}' $p/stat 2>/dev/null)"
	done >$OUT/$1.processes
	brick-power >$OUT/$1.power 2>&1
	sync
}

# Settings to compare: base() restores the boot defaults, tuned() applies the candidate under test.
base() {
	brick-power profile balanced
	brick-power usb-top on
}

tuned() {
	brick-power profile ${TUNED_PROFILE:-balanced}
	brick-power usb-top ${TUNED_USB_TOP:-off}
	# Written after the profile, which sets brick-power's interval (so base() restores it).
	[ -z "${TUNED_SAMPLING:-}" ] || echo $TUNED_SAMPLING >/sys/devices/system/cpu/cpufreq/ondemand/sampling_rate
}

frontend() { sv $1 frontend >/dev/null; }	# $1: start or stop

finish() {	# $1: reason
	PHASE="end ($1)"
	kill $LOAD_PIDS 2>/dev/null
	base
	dispctl on
	frontend start	# does nothing if it is running
	sample
	snapshot end
	sleepnow 0
	exit 0
}

phase() {	# $1: name, $2: minutes (0: skip), $3: seconds between samples
	[ $2 -gt 0 ] || return 0
	PHASE=$1
	snapshot $1.start
	end=$(($(date +%s) + $2 * 60))
	while [ "$(date +%s)" -lt $end ]; do
		sample
		[ "$(cat $BAT/capacity)" -ge 10 ] || finish "low battery"
		sleep $3
	done
	snapshot $1.end
}

load() {	# all four CPUs busy and the GPU drawing, until stopped with kill $LOAD_PIDS
	for i in 1 2 3 4; do
		sh -c 'while :; do :; done' &
		LOAD_PIDS="$LOAD_PIDS $!"
	done
	glspin 100000 >/dev/null 2>&1 &	# seconds: runs until killed
	LOAD_PIDS="$LOAD_PIDS $!"
}

mkdir -p $OUT
# errors.txt: the script's error output and why it stopped (a kill -9 leaves no line)
exec 2>>$OUT/errors.txt
trap 'echo "$(date) exit status $? in phase $PHASE" >&2' EXIT
trap 'echo "$(date) stopped by a signal in phase $PHASE" >&2; exit 1' HUP INT TERM
cat /sys/class/thermal/thermal_zone*/type >$OUT/zones.txt
for f in /sys/class/leds/*/brightness; do echo 0 >$f; done	# LEDs off for the whole test
sleep 60					# time to unplug USB
base
sample

if [ $SLEEP_MIN -gt 0 ]; then
	PHASE=sleep
	snapshot sleep.start
	sleepnow $SLEEP_MIN
	sample
	snapshot sleep.end
fi

phase idle-base $IDLE_MIN 60
tuned
phase idle-tuned $IDLE_MIN 60

if [ $OFF_MIN -gt 0 ]; then
	frontend stop
	dispctl off
	phase off-tuned $OFF_MIN 60
	dispctl on
fi

if [ $LOAD_MIN -gt 0 ]; then
	load
	phase load-tuned $LOAD_MIN 10
	base
	phase load-base $LOAD_MIN 10
fi
finish done
