#!/bin/sh
# sleepnow [minutes]: deep sleep until the power button is pressed or, if minutes > 0, until the
# real-time clock's alarm after that long. Returns once the device is awake again.
# The WiFi driver (XR829) refuses to suspend while connected, so WiFi is stopped first and
# restarted afterwards.
/etc/init.d/wifi stop
ifconfig wlan0 down 2>/dev/null
echo 0 >/sys/class/rtc/rtc0/wakealarm	# clear any old alarm: a new one can't be set over it
[ "${1:-0}" -gt 0 ] && echo "+$(($1 * 60))" >/sys/class/rtc/rtc0/wakealarm
echo mem >/sys/power/state
/etc/init.d/wifi start
