#!/bin/sh
# sleepnow [minutes]: deep sleep until the power button is pressed or, if minutes > 0, until the
# real-time clock's alarm after that long. Returns once the device is awake again.
# The WiFi driver (XR829) refuses to suspend while connected, so WiFi is stopped first and, if
# it was running, restarted afterwards.
# Not while an install or a restore runs (it holds a lock on its status file, see
# userspace/brick-install/src/status.rs): sleeping would stop it partway.
STATUS=/run/brick-install.status
if [ -e $STATUS ] && ! flock -n -s $STATUS true; then
	echo "sleepnow: an install or a restore is running; not sleeping" >&2
	exit 1
fi
WIFI="wpa_supplicant wifi-dhcp" running=
if sv status wpa_supplicant | grep -q '^run:'; then running=1; sv stop $WIFI >/dev/null; fi
ifconfig wlan0 down 2>/dev/null
echo 0 >/sys/class/rtc/rtc0/wakealarm	# clear any old alarm: a new one can't be set over it
[ "${1:-0}" -gt 0 ] && echo "+$(($1 * 60))" >/sys/class/rtc/rtc0/wakealarm
echo mem >/sys/power/state
if [ "$running" ]; then sv start $WIFI >/dev/null; fi
