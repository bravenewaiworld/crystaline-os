#!/bin/sh
# sleepnow [minutes]: deep sleep until the power button is pressed or, if minutes > 0, until the
# real-time clock's alarm after that long. Returns once the device is awake again, unless the
# battery is empty (below).
# The radios are stopped first and, if they were running, started again afterwards (below). The WiFi
# drivers refuse to suspend while connected (the Brick's XR829), or hang the suspend (the RGB20
# Pro's RTL8821CS under ROCKNIX), so WiFi's driver (BOARD_WIFI_MODULE) is also unloaded (its
# service loads it again).
# Not while an install or a restore runs (it holds a lock on its status file, see
# userspace/crystaline-install/src/status.rs): sleeping would stop it partway.
STATUS=/run/crystaline-install.status
if [ -e $STATUS ] && ! flock -n -s $STATUS true; then
	echo "sleepnow: an install or a restore is running; not sleeping" >&2
	exit 1
fi
# With the battery empty (battery-guard's verdict), power off instead of sleeping: the power chip's
# low-battery interrupt wakes the device only when the gauge drops to battery-guard's level
# (dt-tweaks.sh), so a device already there would sleep on to the chip's own cut-off. Checked
# again after waking, which that interrupt causes. One sample is enough here, unlike in the
# service: the device is idle, so there is no load dip to mistake for an empty battery. No game
# runs when Specular calls this, so powering off loses nothing. Caveat: at 1 % with the guard
# distrusting the gauge ("unsure"), the device sleeps and gets no low-battery wake.
poweroff_if_empty() {
	b=$(/usr/libexec/crystaline/battery-guard state)
	[ "${b%% *}" = empty ] || return 0
	logger -s -t sleepnow "battery $b: powering off instead of sleeping"
	/usr/libexec/crystaline/last-shutdown reason battery-empty
	exec poweroff
}
poweroff_if_empty
. /run/crystaline/board.env
# The radios running now, stopped for sleep and started again after it (one sv command each way:
# sv stops or starts its services together). WiFi: its driver refuses to suspend while connected.
# Bluetooth: on the Brick a controller left attached keeps the WiFi/Bluetooth chip powered through
# sleep (about 0.1 W, nearly half the sleep drain); stopping the board's attach service
# (BOARD_BT_ATTACH) powers it off. Paired devices reconnect a few seconds after waking.
RADIOS=
sv status wpa_supplicant | grep -q '^run:' && RADIOS="wpa_supplicant wifi-dhcp"
sv status "${BOARD_BT_ATTACH:-bluetoothd}" 2>/dev/null | grep -q '^run:' &&
	RADIOS="$RADIOS bluealsa bluetoothd ${BOARD_BT_ATTACH:-}"
[ -z "$RADIOS" ] || sv stop $RADIOS >/dev/null
ifconfig wlan0 down 2>/dev/null
[ -z "${BOARD_WIFI_MODULE:-}" ] || [ ! -e /sys/module/$BOARD_WIFI_MODULE ] || rmmod $BOARD_WIFI_MODULE
restart_radios() { [ -z "$RADIOS" ] || sv start $RADIOS >/dev/null; }
echo 0 >/sys/class/rtc/rtc0/wakealarm	# clear any old alarm: a new one can't be set over it
[ "${1:-0}" -gt 0 ] && echo "+$(($1 * 60))" >/sys/class/rtc/rtc0/wakealarm

# A sleep request that hangs (a driver's sleep step waiting forever, e.g. on a stuck SD card
# scan) would otherwise leave the radios off and Specular waiting with nothing logged. After
# GUARD_SECONDS a guard logs the stacks of the tasks stuck in the kernel and starts the radios again.
# It can't end the stuck step, so this script still returns only once that step does; the
# device may then go on to sleep, so the guard also keeps the clock chip's alarm a few seconds
# ahead, and such a sleep ends at once. Only awake time counts: the guard is frozen with every
# other task while the device sleeps.
GUARD_SECONDS=30
guard() {
	sleep $GUARD_SECONDS
	logger -s -t sleepnow "the sleep request hasn't returned after $GUARD_SECONDS s"
	for p in /proc/[0-9]*; do
		grep -q '^State:.D' $p/status 2>/dev/null || continue
		echo "stuck task ${p#/proc/} $(cat $p/comm 2>/dev/null):"
		cat $p/stack 2>/dev/null
	done | logger -t sleepnow
	restart_radios
	while :; do
		echo 0 >/sys/class/rtc/rtc0/wakealarm
		echo +5 >/sys/class/rtc/rtc0/wakealarm
		sleep 4
	done
}
guard & GUARD=$!
echo mem >/sys/power/state || logger -s -t sleepnow "the sleep request failed"
# SIGKILL: a plain kill (SIGTERM) does nothing here, as Specular starts this script with SIGTERM
# blocked, which children inherit. The guard's sleep, left behind, ends by itself.
kill -KILL $GUARD
echo 0 >/sys/class/rtc/rtc0/wakealarm	# awake now: the alarm (ours or the guard's) has done its job
poweroff_if_empty
restart_radios
