 	while (nr) {
 		unsigned long freq = be32_to_cpup(val++) * 1000;
-		sunxi->clk_table[i].volt = be32_to_cpup(val++);
-		sunxi->clk_table[i].true_clk = freq;
-		while (freq < (core_clk[j] * GPU_DFS_MIN)/GPU_DFS_MAX && j < 4)
-			j++;
-		if (j >= 4) {
-			dev_err(sunxi->dev, "%s: give us an OPP table\n", __func__);
+		unsigned long volt = be32_to_cpup(val++);
+
+		nr -= 2;
+		/* gpu_dfs can only express a point from GPU_DFS_MIN/GPU_DFS_MAX of
+		 * core_clk[j] (the PLL divided by j + 1) up to all of it. A point
+		 * outside every divider's range is left out.
+		 */
+		for (j = 0; j < 4; j++) {
+			if (freq <= core_clk[j] &&
+			    freq >= (core_clk[j] * GPU_DFS_MIN) / GPU_DFS_MAX)
+				break;
+		}
+		if (j == 4) {
+			dev_err(sunxi->dev, "%s: %lu Hz is not reachable from the %ld Hz PLL, skipped\n",
+				__func__, freq, sunxi->pll_clk_rate);
+			continue;
 		}
+		sunxi->clk_table[i].volt = volt;
+		sunxi->clk_table[i].true_clk = freq;
 		step = core_clk[j]/16;
 		sunxi->clk_table[i].gpu_dfs = 1<<(GPU_DFS_MAX-freq/step);
 		sunxi->clk_table[i].core_clk =  core_clk[j];
@@ -376,9 +388,10 @@
 				core_clk[j], freq, sunxi->clk_table[i].volt, sunxi->clk_table[i].gpu_dfs);
