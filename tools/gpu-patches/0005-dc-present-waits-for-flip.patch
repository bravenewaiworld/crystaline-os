+/*
+	How long the present waits (_DCWaitUntilShown) of one display context took, for the debug dump.
+	Updated by the presenting thread without a lock: a client presenting from two threads at once
+	can lose counts.
+ */
+typedef struct _DC_PRESENT_WAITS_
+{
+	IMG_UINT32	ui32Count;
+	IMG_UINT32	aui32ByLength[4];		/* <1, 1-18, 18-35 ms, longer: about 0, 1, 2, more refreshes at 60 Hz */
+	IMG_UINT32	ui32Timeouts;
+	IMG_UINT64	ui64TotalUs;
+	IMG_UINT64	ui64LongestUs;
+} DC_PRESENT_WAITS;
