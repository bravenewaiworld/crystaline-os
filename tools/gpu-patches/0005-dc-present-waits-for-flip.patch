+	/* Signalled on every retire: wakes presents waiting for their frame to reach the screen. */
+	IMG_HANDLE		hRetiredEvent;
+	DC_PRESENT_WAITS	sPresentWaits;
 };
 
+/*
+	A client that passes no release fence with a configuration (TrimUI's Vulkan driver) takes the
+	return of DCDisplayContextConfigure as the sign that its previous buffer has left the screen,
+	and starts drawing into it. The display switches to the new buffer only at its next refresh,
+	so the old one is still being scanned out for up to a refresh: the client's drawing shows as
+	tearing. Such configurations therefore return only once they are on screen
+	(_DCWaitUntilShown); their present call then takes about a refresh, at most two. Clients with a
+	release fence (the GL window system) wait on it and are left alone.
+ */
+#define DC_PRESENT_WAIT_TIMEOUT_US	100000
+
+#if defined(__linux__)
+#include <linux/moduleparam.h>
+
+static bool dc_present_waits_for_flip = true;
+module_param(dc_present_waits_for_flip, bool, 0644);
+MODULE_PARM_DESC(dc_present_waits_for_flip, "Configurations without a release fence return only "
+				 "once on screen (default Y; N for measurements: such clients then tear).");
+#else
+#define dc_present_waits_for_flip IMG_TRUE
+#endif
