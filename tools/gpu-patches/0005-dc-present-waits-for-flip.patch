+/*
+	_DCWaitUntilShown
+
+	Returns once the configuration with ui32Token is on screen: every configuration before it has
+	retired, which the display driver does when the display has taken the next one. Also returns
+	after DC_PRESENT_WAIT_TIMEOUT_US (the first timeout of a display context is logged, the rest
+	only counted) and when a signal is pending for the calling thread.
+ */
+static void _DCWaitUntilShown(DC_DISPLAY_CONTEXT *psDisplayContext, IMG_UINT32 ui32Token)
+{
+	DC_PRESENT_WAITS *psWaits = &psDisplayContext->sPresentWaits;
+	IMG_UINT64 ui64Start = OSClockus64();
+	IMG_UINT64 ui64Waited;
+	IMG_HANDLE hEvent;
+
+	if (OSEventObjectOpen(psDisplayContext->hRetiredEvent, &hEvent) != PVRSRV_OK)
+	{
+		PVR_DPF((PVR_DBG_ERROR, "%s: can't open the retire event; the present returns at once "
+		         "(its client may draw into the buffer still shown)", __func__));
+		return;
+	}
+	for (;;)
+	{
+		IMG_UINT32 ui32Retired;
+
+		OSLockAcquire(psDisplayContext->hLock);
+		ui32Retired = psDisplayContext->ui32TokenIn;
+		OSLockRelease(psDisplayContext->hLock);
+		ui64Waited = OSClockus64() - ui64Start;
+		/* Tokens count configurations and wrap around, hence the signed difference. */
+		if ((IMG_INT32)(ui32Token - ui32Retired) <= 0)
+		{
+			break;
+		}
+		if (ui64Waited >= DC_PRESENT_WAIT_TIMEOUT_US)
+		{
+			if (psWaits->ui32Timeouts++ == 0)
+			{
+				PVR_DPF((PVR_DBG_ERROR, "%s: configuration %u not on screen after %" IMG_UINT64_FMTSPEC " us "
+				         "(%u retired so far, %u in flight); returning anyway (the client may draw "
+				         "into the buffer still shown). Later timeouts are counted in the debug "
+				         "dump.", __func__, ui32Token, ui64Waited,
+				         ui32Retired, psDisplayContext->ui32ConfigsInFlight));
+			}
+			break;
+		}
+		/* Waiting on through a pending signal would spin until the timeout. */
+		if (OSEventObjectWaitTimeout(hEvent, DC_PRESENT_WAIT_TIMEOUT_US - ui64Waited) == PVRSRV_ERROR_INTERRUPTED)
+		{
+			break;
+		}
+	}
+	OSEventObjectClose(hEvent);
+
+	psWaits->ui32Count++;
+	psWaits->ui64TotalUs += ui64Waited;
+	if (ui64Waited > psWaits->ui64LongestUs)
+	{
+		psWaits->ui64LongestUs = ui64Waited;
+	}
+	psWaits->aui32ByLength[ui64Waited < 1000 ? 0 : ui64Waited < 18000 ? 1 : ui64Waited < 35000 ? 2 : 3]++;
+}
