#!/bin/sh /etc/rc.common
# File transfer over WiFi on test cards: dufs (github.com/sigoden/dufs) serves the user-data
# partition (see sdcard) over HTTP on port 80, both as WebDAV (mountable in PC file managers) and
# as a browser page for uploading and downloading. No password: anyone on the network can read and
# write the card. procd, OpenWrt's service supervisor, restarts it if it exits.
START=96
USE_PROCD=1

start_service() {
	grep -q " /mnt/SDCARD " /proc/mounts || return 0
	procd_open_instance
	# -A: allow uploads, deletes and search; files are written as root
	procd_set_param command /usr/bin/dufs -A -p 80 /mnt/SDCARD
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance
}
