#!/bin/sh /etc/rc.common
# Bluetooth on test cards: BlueZ's daemon (pairing, connections) and bluealsa, which makes paired
# Bluetooth audio devices usable as ALSA devices ("bluealsa:DEV=<address>"). The controller itself
# is attached by the stock hciattach service (START=80). Pairings are kept in the state area,
# /tmp/state (see sdcard). procd, OpenWrt's service supervisor, restarts both programs if they exit.
START=81
USE_PROCD=1

start_service() {
	procd_open_instance bluetoothd
	# Wait for the state area (procd runs start scripts concurrently), then keep BlueZ's storage
	# directory there.
	procd_set_param command /bin/sh -c 'until grep -q " /tmp/state " /proc/mounts; do sleep 1; done
		mkdir -p /tmp/state/bluetooth /var/lib
		[ -L /var/lib/bluetooth ] || rm -rf /var/lib/bluetooth
		ln -snf /tmp/state/bluetooth /var/lib/bluetooth
		exec /usr/bin/bluetoothd -n'
	procd_set_param respawn
	procd_close_instance

	procd_open_instance bluealsa
	procd_set_param command /usr/bin/bluealsa -p a2dp-source
	procd_set_param respawn
	procd_close_instance
}
