#!/bin/sh /etc/rc.common
# Bluetooth on test cards: attaches the XR829's Bluetooth controller (on serial port ttyS1), then
# runs BlueZ's daemon (pairing, connections) and bluealsa, which makes paired Bluetooth
# headphones/speakers usable as ALSA outputs ("bluealsa:DEV=<address>"; playback only:
# -p a2dp-source). Pairings are kept in the state area, /tmp/state (see sdcard). procd, OpenWrt's
# service supervisor, restarts the programs if they exit.
# Replaces the stock hciattach service. The XR829 has no address of its own, and stock hciattach
# gives the controller a random one each time (so pairings don't survive a reboot); fixing that
# needs our own BlueZ build (see ROADMAP.md).
START=80
USE_PROCD=1

start_service() {
	procd_open_instance hciattach
	procd_set_param command /usr/bin/hciattach -n ttyS1 xradio	# -n: stay in the foreground
	procd_set_param respawn
	procd_close_instance

	procd_open_instance bluetoothd
	# BlueZ's storage directory is kept in the state area, so wait for it: procd doesn't wait for
	# one start script to finish before starting the next (webdav was seen starting before sdcard
	# had mounted the partition).
	procd_set_param command /bin/sh -c 'until grep -q " /tmp/state " /proc/mounts; do sleep 1; done
		mkdir -p /tmp/state/bluetooth /var/lib
		rm -rf /var/lib/bluetooth
		ln -snf /tmp/state/bluetooth /var/lib/bluetooth
		exec /usr/bin/bluetoothd -n'
	procd_set_param respawn
	procd_close_instance

	procd_open_instance bluealsa
	procd_set_param command /usr/bin/bluealsa -p a2dp-source
	procd_set_param respawn
	procd_close_instance
}
