#!/bin/sh /etc/rc.common
# Starts NextUI, our frontend, on test cards running our kernel. On stock firmware TrimUI's
# launcher (runtrimui) starts it; test cards don't run that launcher (build-test-card.sh).
#
# NextUI, games and saves live on the card's "sdcard" partition (FAT32, which NextUI expects and
# PCs can read), mounted at /mnt/SDCARD as on stock firmware. A freshly written card has no such
# partition, since the card image only covers the system partitions, so it is made over two boots:
# 1. add a partition named "sdcard-new" over the rest of the card, then reboot (the kernel won't
#    re-read a disk's partition table while partitions on it, here the root filesystem, are in use);
# 2. format "sdcard-new" and rename it to "sdcard".
# Only a partition this script added is ever formatted.
#
# Installing NextUI is the same as on stock firmware: unzip its release onto that partition.
START=99
SGDISK=/usr/trimui/bin/sgdisk  # part of the stock system, outside the default PATH

# Print the device name of the partition with GPT name $1 (the kernel's PARTNAME), only if
# exactly one exists, so that the built-in storage (eMMC), which has the same partition names, is
# never picked. It is normally invisible when booting from the card: the card's U-Boot leaves its
# controller disabled.
part_by_name() {
	set -- $(grep -l "^PARTNAME=$1\$" /sys/class/block/*/uevent 2>/dev/null)
	[ $# -eq 1 ] && sed -n 's/^DEVNAME=//p' "$1"
}

run() {
	root=$(part_by_name rootfs) || { echo "can't tell which disk is the card"; return 1; }
	disk=/dev/${root%p*}		# mmcblk0p5 -> mmcblk0
	if dev=$(part_by_name sdcard-new); then
		mkfs.fat -F 32 -n NEXTUI /dev/$dev || return
		$SGDISK -c "${dev##*p}:sdcard" $disk >/dev/null || return	# mmcblk0p6 -> 6
	elif ! dev=$(part_by_name sdcard); then
		# The table on the card already has an sdcard(-new) partition the kernel doesn't show
		# (e.g. step 1 ran but no reboot followed): don't add a second one.
		if $SGDISK -p $disk | grep -q ' sdcard'; then
			echo "$disk lists an sdcard partition that the kernel doesn't show"
			return 1
		fi
		# -e: move the backup partition table to the card's end (it is at the image's end);
		# -n 0:0:0: new partition, next free number, over the largest free space; -t 0: and
		# -c 0: set that new partition's type and name; 0700: "Microsoft basic data", the usual
		# type for FAT.
		$SGDISK -e -n 0:0:0 -t 0:0700 -c 0:sdcard-new $disk && reboot
		return
	fi
	# The mount options stock firmware uses for its SD card.
	mount -t vfat -o rw,sync,iocharset=utf8,errors=continue /dev/$dev /mnt/SDCARD || return
	# NextUI writes settings under /etc. The root filesystem is mounted read-only at boot; it is
	# a plain ext4 copy on the card, so these changes persist.
	mount -o remount,rw /

	# NextUI's own entry point (.tmp_update/updater) identifies the device from /proc/cpuinfo,
	# where TrimUI's kernel adds a "hwserial: TG3040..." line (the Brick's model number) that ours
	# lacks. Without it the updater takes the Brick for another device and powers off. So run
	# tg5040.sh directly: "tg5040" is NextUI's platform name for the Brick and the Smart Pro.
	# A freshly unzipped release keeps .tmp_update/ under trimui/app/, where TrimUI's UI starts
	# NextUI's setup from. That setup moves it to the top level and deletes trimui/ (which holds
	# nothing else in a release); do the same.
	if [ -d /mnt/SDCARD/trimui/app/.tmp_update ]; then
		cp -r /mnt/SDCARD/trimui/app/.tmp_update /mnt/SDCARD/ && rm -rf /mnt/SDCARD/trimui
	fi
	if [ -x /mnt/SDCARD/.tmp_update/tg5040.sh ]; then
		/mnt/SDCARD/.tmp_update/tg5040.sh	# installs/updates if needed, then starts NextUI
	else
		echo "no NextUI on the card"
	fi
}

start() {
	# Hold MENU while the system starts (this runs about 14 s after power-on) to skip NextUI, e.g.
	# if it keeps powering the device off. The GPIO list in debugfs shows each button's gpio-keys
	# label after a "|" (set in dt-tweaks.sh; MENU's is "menu"), and "lo" while it is pressed.
	if grep -q '|menu .* lo' /sys/kernel/debug/gpio; then
		logger -t nextui "MENU held: not starting NextUI"
		return
	fi
	# In the background, detached from the boot sequence's output: NextUI runs until power-off.
	(run 2>&1 | logger -t nextui) </dev/null >/dev/null 2>&1 &
}
