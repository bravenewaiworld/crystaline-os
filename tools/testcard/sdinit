#!/bin/sh
# First program the kernel runs on test cards with our kernel (via init=/sbin/sdinit), before
# the normal init. It detaches the internal storage (below), then saves the kernel log to the
# card's FAT "bootloader" partition as sd-boot-log/early-dmesg.txt, which shows whether the kernel
# got as far as starting the system. Then it undoes its mounts (the normal init mounts /proc and
# /sys itself) and hands over.

mount -t proc proc /proc
mount -t sysfs sysfs /sys

# Detach the internal storage (enabled in the device tree by system/board/brick/dt-tweaks.sh)
# before anything else runs, and keep it from attaching again (driver_override names no driver,
# which also stops a delayed probe). TrimUI's start-up links /dev/by-name/* to mmcblk0p*, taken from U-Boot's
# partition list, which assumes the card is mmcblk0. The internal storage may take mmcblk0
# instead, and the stock scripts would then format or mount its partitions (rootfs_data, UDISK).
# The emmc tool attaches it on request.
echo none >/sys/bus/platform/devices/sdc2/driver_override 2>/dev/null
[ -e /sys/bus/platform/devices/sdc2/driver ] && echo sdc2 >/sys/bus/platform/drivers/sunxi-mmc/unbind

# Print the device name of the partition with GPT name $1 (the kernel's PARTNAME), only if
# exactly one exists. The internal eMMC has partitions with the same names; it is detached
# above, but if it is ever attached we must not pick (and write to) its partition.
part_by_name() {
	set -- $(grep -l "^PARTNAME=$1\$" /sys/class/block/*/uevent 2>/dev/null)
	[ $# -eq 1 ] && sed -n 's/^DEVNAME=//p' "$1"
}

save_early_log() {
	dev=$(part_by_name bootloader) || return
	# The kernel has already mounted /dev (DEVTMPFS_MOUNT), so the device node exists.
	# /mnt/SDCARD is an existing empty directory; the root filesystem is read-only, so no mkdir.
	mount -t vfat "/dev/$dev" /mnt/SDCARD || return
	mkdir -p /mnt/SDCARD/sd-boot-log
	dmesg >/mnt/SDCARD/sd-boot-log/early-dmesg.txt
	umount /mnt/SDCARD
}

save_early_log
umount /sys
umount /proc
exec /sbin/init "$@"
