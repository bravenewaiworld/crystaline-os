#!/bin/sh
# First program the kernel runs on test cards with our kernel (via init=/sbin/sdinit), before
# the normal init. It needs no display or LED driver, so it shows whether the kernel got as far
# as starting the system at all:
# - buzzes the rumble motor twice (PH3 = GPIO 227: Allwinner GPIO number = port index * 32 +
#   pin, H = 7; the motor's supply rail is always on);
# - saves the kernel log to the card's FAT "bootloader" partition as sd-boot-log/early-dmesg.txt.
# Then it undoes its mounts (the normal init mounts /proc and /sys itself) and hands over.

mount -t proc proc /proc
mount -t sysfs sysfs /sys

buzz() {
	echo 227 >/sys/class/gpio/export
	echo out >/sys/class/gpio/gpio227/direction
	for i in 1 2; do
		echo 1 >/sys/class/gpio/gpio227/value; usleep 300000
		echo 0 >/sys/class/gpio/gpio227/value; usleep 300000
	done
	echo 227 >/sys/class/gpio/unexport
}

# Print the device name of the partition with GPT name $1 (the kernel's PARTNAME), only if
# exactly one exists. The internal eMMC has partitions with the same names; it is normally
# invisible when booting from the card, but if it ever shows up we must not pick (and write to)
# its partition.
part_by_name() {
	set -- $(grep -l "^PARTNAME=$1\$" /sys/class/block/*/uevent 2>/dev/null)
	[ $# -eq 1 ] && sed -n 's/^DEVNAME=//p' "$1"
}

save_early_log() {
	dev=$(part_by_name bootloader) || return
	# The kernel has already mounted /dev (DEVTMPFS_MOUNT), so the device node exists.
	# /mnt/SDCARD is an existing empty directory; the root filesystem is read-only, so no mkdir.
	mount -t vfat "/dev/$dev" /mnt/SDCARD || return
	mkdir -p /mnt/SDCARD/sd-boot-log
	dmesg >/mnt/SDCARD/sd-boot-log/early-dmesg.txt
	umount /mnt/SDCARD
}

buzz
save_early_log
umount /sys
umount /proc
exec /sbin/init "$@"
