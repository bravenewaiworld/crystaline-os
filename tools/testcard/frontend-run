#!/bin/sh
# Runs Specular, with the SD card's data partition as its data folder. If it has been started 3
# times within a minute (it keeps failing: procd restarts it whenever it exits), runs the
# placeholder status instead, until the next boot, so the device still shows its battery and
# sleeps, and can be fixed over adb or SSH. The script replaces itself with Specular (exec), so
# procd's stop signal reaches Specular itself, which then saves and quits.
STARTS=/tmp/frontend-starts
FALLBACK=/tmp/frontend-fallback
[ -e $FALLBACK ] && exec /usr/bin/status
now=$(date +%s)
echo "$now" >>$STARTS
recent=$(awk -v since=$((now - 60)) '$1 >= since { n++ } END { print n + 0 }' $STARTS)
if [ "$recent" -gt 3 ]; then
	echo "frontend: Specular started $((recent - 1)) times within a minute; running status" >&2
	touch $FALLBACK
	exec /usr/bin/status
fi
exec /usr/lib/specular/specular /mnt/SDCARD
