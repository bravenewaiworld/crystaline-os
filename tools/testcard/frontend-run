#!/bin/sh
# Runs Specular, with the SD card's data partition as its data folder. If it has failed 3 times
# within a minute, runs the placeholder status instead, until the next boot, so the device still
# shows its battery and sleeps, and can be fixed over adb or SSH.
CRASHES=/tmp/frontend-crashes
FALLBACK=/tmp/frontend-fallback
[ -e $FALLBACK ] && exec /usr/bin/status
/usr/lib/specular/specular /mnt/SDCARD
code=$?
[ $code -eq 0 ] && exit 0
now=$(date +%s)
echo "$now" >>$CRASHES
recent=$(awk -v since=$((now - 60)) '$1 >= since' $CRASHES | wc -l)
if [ "$recent" -ge 3 ]; then
	echo "frontend: Specular failed $recent times within a minute (last exit $code); running status" >&2
	touch $FALLBACK
fi
exit $code
