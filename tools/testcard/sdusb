#!/bin/sh /etc/rc.common
# USB connection to a PC for test cards running our kernel: adb plus a USB network link (NCM,
# the USB network-adapter protocol Linux PCs support without drivers) on the bottom USB-C port. The Brick takes 192.168.7.2 and hands the PC an address in
# 192.168.7.10-20 by DHCP, with no gateway or DNS, so the PC's internet routing is untouched.
# Then: `ssh root@192.168.7.2` or `adb shell`.
#
# configfs builds the USB device the PC sees (the "gadget") from "functions" (adb, network).
# Writing the USB controller's name to $G/UDC connects it, and functions are fixed after that.
# TrimUI's adbd does that as soon as it starts, so this runs first (adbd's script is START=80)
# and adbd's script then skips the setup steps already done here.
START=79

G=/sys/kernel/config/usb_gadget/g1     # the gadget name TrimUI's adbd script uses
IP=192.168.7.2

# wait_until SECONDS COMMAND...: true once COMMAND succeeds, checking every second.
wait_until() {
	i=$1; shift
	until "$@"; do
		[ $i -le 0 ] && return 1
		sleep 1; i=$((i - 1))
	done
}
connected() { [ -n "$(cat $G/UDC)" ]; }
have_usb0() { [ -d /sys/class/net/usb0 ]; }

setup_gadget() {
	# Reading usb_device switches the port to device mode. Normally the port follows cable
	# detection by the PMIC's USB power-supply driver, which our kernel doesn't have yet.
	cat /sys/devices/platform/soc/usbc0/usb_device >/dev/null

	[ -d /sys/kernel/config/usb_gadget ] || mount -t configfs none /sys/kernel/config
	mkdir -p $G/strings/0x409 $G/configs/c.1/strings/0x409 $G/functions/ncm.usb0
	echo 0x18d1 >$G/idVendor     # Google's USB vendor ID, which adb on the PC recognises,
	echo 0xd002 >$G/idProduct    # with the product ID TrimUI's adbd script uses
	echo TRIMUI >$G/strings/0x409/manufacturer
	echo "Brick test card" >$G/strings/0x409/product
	echo 0xc0 >$G/configs/c.1/bmAttributes   # self-powered
	echo 500 >$G/configs/c.1/MaxPower        # mA
	[ -e $G/configs/c.1/ncm.usb0 ] || ln -s $G/functions/ncm.usb0 $G/configs/c.1/ncm.usb0
}

# adbd connects the gadget to the USB controller once it's ready. On some boots that first
# connection leaves the network function out (no usb0 appears), so reconnect once, straight
# away, rather than in the middle of someone's adb session later.
setup_network() {
	wait_until 60 connected || return
	wait_until 3 have_usb0 || {
		echo "" >$G/UDC; sleep 1
		ls /sys/class/udc >$G/UDC   # the A133 has one USB device controller, 5100000.udc-controller
		wait_until 10 have_usb0 || { logger -t sdusb "usb0 missing after USB reconnect"; return; }
	}
	ifconfig usb0 $IP netmask 255.255.255.0 up
	cat >/tmp/udhcpd-usb0.conf <<EOF
interface usb0
start 192.168.7.10
end 192.168.7.20
max_leases 10
lease_file /tmp/udhcpd-usb0.leases
EOF
	touch /tmp/udhcpd-usb0.leases
	udhcpd /tmp/udhcpd-usb0.conf
}

boot() {
	setup_gadget
	# In the background: it waits for adbd, which starts after this script.
	setup_network >/dev/null 2>&1 &
}
