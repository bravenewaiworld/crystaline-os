#!/bin/sh /etc/rc.common
# Test-card marker for the stock system running from an SD card (added to the card's copy of
# the stock root filesystem; never installed on the internal storage).
# Saves the kernel log and boot details to the card's "bootloader" partition (FAT, readable on
# a PC) in sd-boot-log/.
START=96

# Print the device name of the partition with GPT name $1 (the kernel's PARTNAME), only if
# exactly one exists. The internal eMMC has partitions with the same names; it is normally
# invisible when booting from the card, but if it ever shows up we must not pick (and write to)
# its partition.
part_by_name() {
	set -- $(grep -l "^PARTNAME=$1\$" /sys/class/block/*/uevent 2>/dev/null)
	[ $# -eq 1 ] && sed -n 's/^DEVNAME=//p' "$1"
}

save_logs() {
	dev=$(part_by_name bootloader)
	[ -n "$dev" ] || return
	mkdir -p /tmp/sdlog
	mount -t vfat "/dev/$dev" /tmp/sdlog || return
	d=/tmp/sdlog/sd-boot-log
	mkdir -p $d
	{
		cat /etc/sd-boot-marker
		uname -a
		echo "log saved at uptime: $(cut -d' ' -f1 /proc/uptime) s"
		echo "cmdline: $(cat /proc/cmdline)"
		echo; cat /proc/partitions
		echo; grep -H . /sys/class/block/*/uevent | grep -E 'DEVNAME|PARTNAME'
		echo; cat /proc/mounts
		echo; cat /proc/modules
	} >$d/summary.txt 2>&1
	dmesg >$d/dmesg.txt 2>&1
	logread >$d/logread.txt 2>&1
	ps w >$d/ps.txt 2>&1
	sync
	umount /tmp/sdlog
}

boot() {
	# Save logs right away and then every 30 s for a few minutes, so something survives even if
	# the system dies soon after starting.
	(
		save_logs
		for i in 1 2 3 4 5 6; do sleep 30; save_logs; done
	) >/dev/null 2>&1 &
}
