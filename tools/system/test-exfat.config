# Added to trimui_brick_defconfig for test-exfat.sh's QEMU kernel: QEMU's "virt" board (serial
# port, virtual disk) and lock checking (lockdep), so a locking mistake in the exFAT driver shows
# up as a kernel warning. test-exfat.sh checks that PROVE_LOCKING survived.
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_LIST=y
